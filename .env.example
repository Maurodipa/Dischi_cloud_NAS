# === Dischi Cloud Configuration ===

# Percorso disco primario (dove vengono salvati i file)
# Raspberry Pi / Linux (Consigliato): /mnt/disk1/CloudData
# Windows (test locale): C:/CloudData oppure D:/CloudData
PRIMARY_DISK=/mnt/disk1/CloudData

# Percorso disco backup (mirror automatico)
# Raspberry Pi / Linux (Consigliato): /mnt/disk2/CloudBackup
# Windows (test locale): C:/CloudBackup oppure E:/CloudBackup
BACKUP_DISK=/mnt/disk2/CloudBackup

# Porta HTTPS per la web UI
HTTPS_PORT=443

# Porta WebDAV per montare come disco di rete
WEBDAV_PORT=1900

# Segreto JWT (generato automaticamente al primo avvio se vuoto)
JWT_SECRET=

# Durata access token in minuti
ACCESS_TOKEN_EXPIRY=15

# Durata refresh token in giorni
REFRESH_TOKEN_EXPIRY=7

# Limite dimensione upload in bytes (default: 1 TB)
MAX_UPLOAD_SIZE=1099511627776

# Livello di log (error, warn, info, debug)
LOG_LEVEL=info

# Abilitare sync in tempo reale (true/false)
SYNC_ENABLED=true
